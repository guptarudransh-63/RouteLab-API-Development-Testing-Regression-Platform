# RouteLab Server Environment Configuration
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/routelab
JWT_SECRET=routelab_super_secret_jwt_key_development_change_in_production_32char
JWT_EXPIRES_IN=7d
COOKIE_SECRET=routelab_cookie_secret_salt_12345

# Request Execution & SSRF Protection
# Set to 'true' ONLY in local dev to allow requests to localhost/loopback or 10.x/192.168.x
ALLOW_LOCAL_REQUESTS=true
REQUEST_TIMEOUT_MS=15000
MAX_RESPONSE_SIZE_BYTES=10485760

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
